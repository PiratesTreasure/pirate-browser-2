{
  "name": "pirate-browser-2",
  "version": "2.6.4",
  "description": "Pirate Browser 2.0 — Multi-account ShippingManager automation suite",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable",
    "build:installer": "electron-builder --win nsis"
  },
  "keywords": [
    "shippingmanager",
    "automation",
    "electron",
    "userscript"
  ],
  "author": "PiratesTreasure / https://github.com/PiratesTreasure",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "org.piratestreaure.pirate-browser",
    "productName": "Pirate Browser 2.0",
    "artifactName": "Pirate-Browser-2.0-Setup-${version}.${ext}",
    "copyright": "Copyright © 2026 PiratesTreasure",
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico",
      "requestedExecutionLevel": "asInvoker",
      "signingHashAlgorithms": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Pirate Browser 2.0",
      "deleteAppDataOnUninstall": false,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "displayLanguageSelector": false
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "src/scripts/**"
    ],
    "extraFiles": [
      {
        "from": "node_modules/electron/dist/ffmpeg.dll",
        "to": "ffmpeg.dll"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "PiratesTreasure",
      "repo": "pirate-browser-2"
    },
    "forceCodeSigning": false
  }
}
